---
import { ClientRouter } from 'astro:transitions';
import LiquidNav from '../components/LiquidNav';
import '../styles/global.css';
interface Props {
  title: string;
  activePage: string;
}

const { title, activePage } = Astro.props;

const navItems = [
  { href: '/', label: 'Home', icon: '🏠', id: 'home' },
  { href: '/calendario', label: 'Calendario', icon: '📅', id: 'calendario' },
  { href: '/classifica', label: 'Classifica', icon: '🏆', id: 'classifica' },
];
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Memorial Gerry The Cage - Torneo di calcio a 5. Squadre, calendario, classifica e marcatori." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0a0f1d" />
    <link rel="apple-touch-icon" href="/Logo_Torneo.jpg" />
    <title>{title} | Memorial Gerry The Cage</title>
    <ClientRouter />
  </head>

  <body>
    <!-- Fixed Background Image -->
    <div class="bg-blobs" transition:persist="fixed-background"></div>

    <div class="app-layout" transition:animate="none">
      <!-- Main -->
      <main class="main-content" transition:animate="none">
        <!-- Mobile topbar -->
        <div class="mobile-topbar" transition:animate="none">
          <div class="mobile-topbar-content" style="display: flex; align-items: center; gap: 8px; width: 100%;">
            <img src="/Logo_Torneo.jpg" alt="Logo Torneo" style="width:28px;height:28px;border-radius:6px;object-fit:cover;flex-shrink:0;box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);" />
            <div style="font-size:0.85rem;font-weight:700;color:var(--text-primary);letter-spacing:-0.02em;">Memorial Gerry The Cage</div>
          </div>
        </div>

        <div transition:animate="fade">
          <slot />
        </div>

        <!-- Footer with discrete Admin link -->
        <footer style="text-align: center; padding: 40px 0 120px 0; opacity: 0.25; font-size: 0.75rem; color: var(--text-muted); display: flex; justify-content: center; gap: 8px; align-items: center; width: 100%;">
          <span>&copy; 2026 Memorial Gerry The Cage</span>
          <span>&bull;</span>
          <a href="/admin" style="color: inherit; text-decoration: none; border-bottom: 1px dashed rgba(255,255,255,0.3); padding-bottom: 1px;">Area Admin</a>
        </footer>
      </main>
    </div>

    <!-- Liquid Glass Bottom Nav (mobile) -->
    <div transition:animate="none" style="position: fixed; z-index: 9999; bottom: 24px; left: 0; right: 0; display: flex; justify-content: center; pointer-events: none; padding: 0 16px;">
      <LiquidNav client:load activePage={activePage} />
    </div>

    <!-- PWA Install Banner (Android / Chrome) -->
    <div id="pwa-install-banner" style="position: fixed; bottom: 100px; left: 50%; transform: translateX(-50%); width: calc(100% - 32px); max-width: 480px; z-index: 9999; display: none; justify-content: space-between; align-items: center; padding: 12px 16px; background: rgba(15, 23, 42, 0.8); backdrop-filter: blur(16px) saturate(180%); -webkit-backdrop-filter: blur(16px) saturate(180%); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 20px; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5); color: white; transition: all 0.3s ease;">
      <div style="display: flex; align-items: center; gap: 10px;">
        <img src="/Logo_Torneo.jpg" alt="Logo" style="width: 38px; height: 38px; border-radius: 8px; object-fit: cover;" />
        <div>
          <div style="font-size: 0.85rem; font-weight: 700; color: white;">Installa l'App</div>
          <div style="font-size: 0.75rem; color: rgba(255, 255, 255, 0.7);">Aggiungi "The Cage" alla schermata Home</div>
        </div>
      </div>
      <div style="display: flex; align-items: center; gap: 8px;">
        <button id="pwa-install-btn" class="install-btn" style="background: #1d4ed8; color: white; font-size: 0.75rem; font-weight: 700; border: none; padding: 8px 16px; border-radius: 12px; cursor: pointer; margin: 0; box-shadow: none;">Installa</button>
        <button id="pwa-close-banner-btn" style="background: transparent; color: rgba(255, 255, 255, 0.5); font-size: 1rem; border: none; padding: 4px 8px; cursor: pointer;">✕</button>
      </div>
    </div>

    <!-- PWA Helper Guide (iOS / Safari) -->
    <div id="pwa-ios-banner" style="position: fixed; bottom: 100px; left: 50%; transform: translateX(-50%); width: calc(100% - 32px); max-width: 480px; z-index: 9999; display: none; flex-direction: column; gap: 8px; padding: 16px; background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(16px) saturate(180%); -webkit-backdrop-filter: blur(16px) saturate(180%); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 20px; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5); color: white; transition: all 0.3s ease;">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; width: 100%;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <img src="/Logo_Torneo.jpg" alt="Logo" style="width: 38px; height: 38px; border-radius: 8px; object-fit: cover;" />
          <div>
            <div style="font-size: 0.85rem; font-weight: 700; color: white;">Installa "The Cage" su iPhone</div>
            <div style="font-size: 0.75rem; color: rgba(255, 255, 255, 0.7);">Segui questi semplici passi:</div>
          </div>
        </div>
        <button id="pwa-ios-close-btn" style="background: transparent; color: rgba(255, 255, 255, 0.5); font-size: 1rem; border: none; padding: 4px 8px; cursor: pointer;">✕</button>
      </div>
      <div style="font-size: 0.75rem; color: rgba(255, 255, 255, 0.9); line-height: 1.4; padding-left: 48px;">
        1. Premi il pulsante di condivisione <span style="font-size: 0.9rem; padding: 0 2px;">📤</span> in fondo al browser.<br/>
        2. Scorri e seleziona <strong>"Aggiungi alla schermata Home"</strong>.
      </div>
    </div>

    <script>
      // Register Service Worker only in production to prevent local development caching
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js')
            .then(reg => console.log('Service Worker registered successfully:', reg.scope))
            .catch(err => console.error('Service Worker registration failed:', err));
        });
      }

      // Handle Install Prompt (Android/Chrome)
      let deferredPrompt: any = null;

      function setupPWAHandlers() {
        const installBanner = document.getElementById('pwa-install-banner');
        const installBtn = document.getElementById('pwa-install-btn');
        const closeBtn = document.getElementById('pwa-close-banner-btn');
        const iosBanner = document.getElementById('pwa-ios-banner');
        const iosCloseBtn = document.getElementById('pwa-ios-close-btn');

        if (closeBtn && installBanner) {
          closeBtn.addEventListener('click', () => {
            installBanner.style.display = 'none';
            // Save state in sessionStorage so we don't annoy the user in this session
            sessionStorage.setItem('pwa-dismissed', 'true');
          });
        }

        if (installBtn) {
          installBtn.addEventListener('click', async () => {
            if (deferredPrompt) {
              deferredPrompt.prompt();
              const { outcome } = await deferredPrompt.userChoice;
              console.log(`User choice outcome: ${outcome}`);
              deferredPrompt = null;
              if (installBanner) installBanner.style.display = 'none';
            }
          });
        }

        if (iosCloseBtn && iosBanner) {
          iosCloseBtn.addEventListener('click', () => {
            iosBanner.style.display = 'none';
            sessionStorage.setItem('pwa-dismissed', 'true');
          });
        }

        // Check if already dismissed in this session
        if (sessionStorage.getItem('pwa-dismissed') === 'true') {
          return;
        }

        // Show cached prompt if available
        if (deferredPrompt && installBanner) {
          installBanner.style.display = 'flex';
        }

        // Handle iOS specific helper
        const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !(window as any).MSStream;
        const isStandalone = window.matchMedia('(display-mode: standalone)').matches || (navigator as any).standalone;

        if (isIOS && !isStandalone && iosBanner) {
          // Show iOS installation guide after 3 seconds
          setTimeout(() => {
            if (sessionStorage.getItem('pwa-dismissed') !== 'true') {
              iosBanner.style.display = 'flex';
            }
          }, 3000);
        }
      }

      // Capture beforeinstallprompt globally
      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredPrompt = e;
        
        // Show banner if we are on the page
        const installBanner = document.getElementById('pwa-install-banner');
        if (installBanner && sessionStorage.getItem('pwa-dismissed') !== 'true') {
          installBanner.style.display = 'flex';
        }
      });

      // Hook up on page load (support View Transitions)
      document.addEventListener('astro:page-load', setupPWAHandlers);
      
      // Fallback for initial load
      if (document.readyState === 'complete' || document.readyState === 'interactive') {
        setupPWAHandlers();
      } else {
        window.addEventListener('DOMContentLoaded', setupPWAHandlers);
      }
    </script>
  </body>
</html>
