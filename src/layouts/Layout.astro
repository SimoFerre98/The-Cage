---
import { ClientRouter } from 'astro:transitions';
import LiquidNav from '../components/LiquidNav';
import '../styles/global.css';
interface Props {
  title: string;
  activePage: string;
}

const { title, activePage } = Astro.props;

const navItems = [
  { href: '/', label: 'Hub', icon: '🏠', id: 'hub' },
  { href: '/calendario', label: 'Calendario', icon: '📅', id: 'calendario' },
  { href: '/classifica', label: 'Classifica', icon: '🏆', id: 'classifica' },
];
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Memorial Gerry The Cage - Torneo di calcio a 5. Squadre, calendario, classifica e marcatori." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Memorial Gerry The Cage</title>
    <ClientRouter />
  </head>

  <body>
    <!-- Fixed Background Image -->
    <div class="bg-blobs" transition:persist="fixed-background"></div>

    <div class="app-layout" transition:animate="none">
      <!-- Main -->
      <main class="main-content" transition:animate="none">
        <!-- Mobile topbar -->
        <div class="mobile-topbar" transition:animate="none">
          <div class="mobile-topbar-content">
            <img src="/Logo_Torneo.jpg" alt="Logo Torneo" style="width:28px;height:28px;border-radius:6px;object-fit:cover;flex-shrink:0;box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);" />
            <div style="font-size:0.85rem;font-weight:700;color:var(--text-primary);letter-spacing:-0.02em;">Memorial Gerry The Cage</div>
          </div>
        </div>

        <div transition:animate="fade">
          <slot />
        </div>
      </main>
    </div>

    <!-- Liquid Glass Bottom Nav (mobile) -->
    <div transition:animate="none" style="position: fixed; z-index: 9999; bottom: 24px; left: 0; right: 0; display: flex; justify-content: center; pointer-events: none; padding: 0 16px;">
      <LiquidNav client:load activePage={activePage} />
    </div>

    <script>
      // Non ci serve piu il menu laterale o l'hamburger
    </script>
  </body>
</html>
