---
import { ClientRouter } from 'astro:transitions';
import LiquidNav from '../components/LiquidNav';
import '../styles/global.css';

interface Props {
  title: string;
  activePage: string;
}

const { title, activePage } = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Live Match - Memorial Gerry The Cage." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Memorial Gerry The Cage</title>
    <ClientRouter />
  </head>

  <body>
    <!-- Fixed Background Image -->
    <div class="bg-blobs" transition:persist="fixed-background"></div>

    <!-- Main Content without padding for full bleed -->
    <div class="flex flex-col min-h-screen">
      <main class="w-full flex-1 pb-16">
        <slot />
      </main>

      <!-- Liquid Glass Bottom Nav (mobile) -->
      <div style="position: fixed; z-index: 9999; bottom: 0; left: 0; right: 0; pointer-events: none;">
        <LiquidNav client:load activePage={activePage} />
      </div>
    </div>
  </body>
</html>
